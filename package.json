{
  "name": "agentic-crm",
  "version": "0.1.1",
  "description": "TypeScript CRM SDK, CLI, and MCP server for prospects, vendors, and sales leads with Cloudflare D1 storage and Workers KV mirroring.",
  "keywords": [
    "crm",
    "typescript",
    "nodejs",
    "prospects",
    "vendors",
    "sales-leads",
    "sales-pipeline",
    "cloudflare",
    "cloudflare-d1",
    "workers-kv",
    "cloudflare-workers",
    "cli",
    "mcp"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-crm.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-crm",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-crm": "./dist/cli.js",
    "agentic-crm-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "agentic-core": "0.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
